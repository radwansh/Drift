# This file documents all required environment variables.
# For local development, copy to apps/web/.env.local (Next.js does not
# auto-load .env from the monorepo root).

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/drift"

# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/login"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/signup"

# Claude AI (Anthropic)
ANTHROPIC_API_KEY="sk-ant-..."
# Optional; defaults to claude-sonnet-5. The old CLAUDE_MODEL variable was never
# read by any code and has been removed.
ANTHROPIC_MODEL="claude-sonnet-5"

# Redis (for BullMQ background jobs)
REDIS_URL="redis://localhost:6379"

# Cloudflare R2 (file storage)
R2_ENDPOINT="https://account-id.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID="..."
R2_SECRET_ACCESS_KEY="..."
R2_BUCKET_NAME="saas-payroll-files"

# Polar Billing - get from https://polar.sh (or https://sandbox.polar.sh)
#
# All optional. With none of them set, billing degrades to exactly what the app
# did before Polar existed: the billing page shows the plan ladder with no
# checkout buttons and no "Manage billing" control, and /api/webhooks/polar
# answers 503 and processes nothing. Nothing throws and no build fails.
#
# These replace the STRIPE_* block that used to sit here. Nothing ever read it:
# there was no Stripe SDK, no webhook and no STRIPE_* key read anywhere in the
# app, so the three names documented an integration that did not exist.

# Organization access token. Enables the customer portal (and nothing else).
POLAR_ACCESS_TOKEN="polar_oat_..."

# Webhook signing secret, from Settings -> Webhooks on the endpoint you add for
# <app url>/api/webhooks/polar. Without it the route refuses every delivery:
# a webhook that cannot verify a signature must not trust one.
POLAR_WEBHOOK_SECRET="whsec_..."

# "sandbox" points the API at sandbox-api.polar.sh. Anything else (or unset) is
# production. Sandbox needs its own token; a production one is refused there.
POLAR_SERVER="sandbox"

# Checkout Links, one per plan. Polar's Checkout Links are per product, so there
# is no single link that covers the ladder: the Starter link is Starter,
# monthly, in EUR. A plan with no link here simply has no checkout button.
# Create them at Polar -> Checkout Links; the app appends `reference_id` so the
# webhook can map a payment back to the company that started it.
POLAR_CHECKOUT_LINK_STARTER="https://buy.polar.sh/polar_cl_..."
POLAR_CHECKOUT_LINK_GROWTH="https://buy.polar.sh/polar_cl_..."
POLAR_CHECKOUT_LINK_ENTERPRISE=""
POLAR_CHECKOUT_LINK_BUREAU=""

# Product ids, one per plan. The webhook maps the product an order names back to
# a plan; a product it does not recognise records the subscription and leaves
# `plan` alone rather than guessing which rung was bought.
POLAR_PRODUCT_ID_STARTER="..."
POLAR_PRODUCT_ID_GROWTH="..."
POLAR_PRODUCT_ID_ENTERPRISE=""
POLAR_PRODUCT_ID_BUREAU=""

# Zoho CRM - get from https://api-console.zoho.com
ZOHO_CLIENT_ID="..."
ZOHO_CLIENT_SECRET="..."
ZOHO_REFRESH_TOKEN="..."
ZOHO_ACCOUNTS_URL="https://accounts.zoho.com"

# Resend (transactional email) - get from https://resend.com
RESEND_API_KEY="re_..."
RESEND_AUDIENCE_ID="..."

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Drift"
